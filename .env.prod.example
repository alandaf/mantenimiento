# Copia a .env.prod en el servidor y rellena. NO se versiona.
#
#   cp .env.prod.example .env.prod

# --- Base de datos -----------------------------------------------------------
POSTGRES_USER=simarp
POSTGRES_DB=simarp
# Genera una: openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Dirección pública -------------------------------------------------------
# Solo si levantas Caddy (compose.caddy.yml), es decir si nadie más usa los
# puertos 80/443. Con un proxy propio delante (compose.host-proxy.yml) esta
# variable sobra: el certificado lo gestiona ese proxy.
#   Con dominio → SITE_ADDRESS=pms.tudominio.cl   (HTTPS automático)
#   Sin dominio → SITE_ADDRESS=:80                (HTTP contra la IP)
SITE_ADDRESS=

# Solo con compose.host-proxy.yml: puerto local al que apunta el proxy.
# Se ata a 127.0.0.1, no queda expuesto. Comprueba que esté libre en el
# servidor antes de fijarlo: ss -lntp | grep 3210
WEB_LOCAL_PORT=3210

# Tiene que coincidir con cómo se llega desde el navegador, con esquema.
# Con dominio: https://pms.tudominio.cl   ·   Sin dominio: http://91.99.175.78
BETTER_AUTH_URL=

# --- Secretos ----------------------------------------------------------------
# Firma las sesiones. Genera uno nuevo, distinto al de desarrollo:
#   openssl rand -base64 32
# Cambiarlo cierra la sesión de todo el mundo.
BETTER_AUTH_SECRET=

# --- IA (opcional) -----------------------------------------------------------
# Sin esto, la priorización y el análisis de causa raíz quedan deshabilitados;
# el resto de la aplicación funciona igual.
GEMINI_API_KEY=
GEMINI_MODEL=
