# Copia a .env.prod en el servidor y rellena. NO se versiona.
#
#   cp .env.prod.example .env.prod

# --- Base de datos -----------------------------------------------------------
POSTGRES_USER=simarp
POSTGRES_DB=simarp
# Genera una: openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Dirección pública -------------------------------------------------------
# Con dominio  → HTTPS automático:      SITE_ADDRESS=pms.tudominio.cl
# Sin dominio  → HTTP contra la IP:     SITE_ADDRESS=:80
# Un certificado necesita un nombre de dominio; con una IP desnuda no hay forma
# de emitirlo.
SITE_ADDRESS=

# Tiene que coincidir con cómo se llega desde el navegador, con esquema.
# Con dominio: https://pms.tudominio.cl   ·   Sin dominio: http://91.99.175.78
BETTER_AUTH_URL=

# --- Secretos ----------------------------------------------------------------
# Firma las sesiones. Genera uno nuevo, distinto al de desarrollo:
#   openssl rand -base64 32
# Cambiarlo cierra la sesión de todo el mundo.
BETTER_AUTH_SECRET=

# --- IA (opcional) -----------------------------------------------------------
# Sin esto, la priorización y el análisis de causa raíz quedan deshabilitados;
# el resto de la aplicación funciona igual.
GEMINI_API_KEY=
GEMINI_MODEL=
