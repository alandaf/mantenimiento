# Conexión a Postgres. Dentro de Docker el host es el nombre del servicio: "db".
DATABASE_URL=postgres://gmao:gmao@db:5432/gmao

# Credenciales del contenedor de Postgres
POSTGRES_USER=gmao
POSTGRES_PASSWORD=gmao
POSTGRES_DB=gmao

# Priorización con IA (Google Gemini). Sin esta clave la app funciona igual, pero el botón
# "Priorizar con IA" queda deshabilitado (el score determinista no la necesita).
GEMINI_API_KEY=
# Opcional: fija otro modelo. Por defecto gemini-3.5-flash.
GEMINI_MODEL=

# Puerto local de la app (3000 suele estar ocupado)
WEB_PORT=3100
